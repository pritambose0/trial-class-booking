NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (replace <user>, <password>, <cluster>)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional database name; overrides the one in the URI
MONGODB_DB_NAME=trial-class-booking
