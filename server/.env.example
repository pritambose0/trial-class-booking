NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (replace <user>, <password>, <cluster>)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Optional database name; overrides the one in the URI
MONGODB_DB_NAME=trial-class-booking

# Base URL used to generate dummy meeting links for trial classes
MEETING_BASE_URL=https://meet.jit.si

# SMTP credentials for sending booking confirmation emails.
# If these are omitted, emails are generated and logged instead of sent.
MAIL_FROM=Trial Class Booking <no-reply@trialclass.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
